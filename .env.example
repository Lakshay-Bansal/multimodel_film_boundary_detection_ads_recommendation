# Hugging Face Access Token (Free Serverless Inference API)
# Get a free User Access Token (Read permissions) from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_token_here

# Hugging Face Vision Model for Keyframe Captioning
# Recommended free models:
#   - Salesforce/blip-image-captioning-large (Default)
#   - Salesforce/blip-image-captioning-base
#   - Salesforce/blip2-opt-2.7b
HF_MODEL=Salesforce/blip-image-captioning-large

# Number of representative keyframes to sample per video clip (default: 3)
HF_NUM_FRAMES=3

# Optional: Legacy hosted Video-LLaVA microservice URL
# VIDEO_LLAVA_URL=http://localhost:8084/describe_video

# Optional: OpenRouter API Key
OPEN_ROUTER_API=your_openrouter_api_key_here
